# Local development settings for `npm run dev` / `cargo run -p atlas-server`.
# Copy to `.env` (gitignored). Debug builds read it; release builds and the
# Docker image never do. Production settings live in Jupiter's compose file.

# Sign everyone in as this user, without an identity provider. Use your
# Authentik username so data paths match the server's (users/<username>).
ATLAS_DEV_USER=dev

# Optional: try real sign-in against Authentik instead (remove ATLAS_DEV_USER).
# The provider must allow http://localhost:1420/auth/callback as a redirect URI.
# ATLAS_PUBLIC_URL=http://localhost:1420
# ATLAS_OIDC_ISSUER=https://auth.jupiter.sunstead.net/application/o/atlas/
# ATLAS_OIDC_CLIENT_ID=atlas
# ATLAS_OIDC_CLIENT_SECRET=
# ATLAS_OIDC_ALLOWED_GROUPS=homelab-users

# Seals saved API keys. Dev sign-in falls back to a built-in key without it.
# Make one with: openssl rand -base64 32
# ATLAS_MASTER_KEY=

# Sources. Each kind is offered on the connections page only when set.
# ATLAS_IMMICH_URL=https://immich.jupiter.sunstead.net
# ATLAS_OPENCLOUD_URL=https://opencloud.jupiter.sunstead.net
# For local file search, point it at a folder with one subfolder per user
# (your files in ./.data/files/users/<ATLAS_DEV_USER>/):
# ATLAS_OPENCLOUD_USERS_DIR=./.data/files/users

# Where atlas.db and the search index live (defaults below).
# ATLAS_STATE_DIR=.data/state
# ATLAS_INDEX_DIR=.data/index
