{
  "name": "atlas",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,app -c yellow,cyan \"cargo run -p atlas-server\" \"npm run dev -w app\"",
    "dev:app": "npm run dev -w app",
    "dev:server": "cargo run -p atlas-server",
    "build": "npm run build -w app",
    "lint": "eslint .",
    "test": "npm test -w app"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  }
}
